# Environment variables for Affiliate Hub Backend

# Server configuration
PORT=3001

# JWT Secret (REQUIRED — set a strong, random value in production!)
JWT_SECRET=change-me-to-a-long-random-string

# Database (SQLite uses file-based database)
DATABASE_PATH=./affiliate-hub.db

# CORS: comma-separated list of allowed origins.
# Set to your Vercel frontend origin(s) in production, e.g.
# CORS_ORIGINS=https://your-app.vercel.app,https://www.example.com
# Leave as * to allow all origins (not recommended for production).
CORS_ORIGINS=*
