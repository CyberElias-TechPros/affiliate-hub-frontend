# Frontend environment variables (Vite)

# Base URL of the backend API.
# - For local development: leave unset — the Vite dev server proxies /api/* to
#   the backend running at http://localhost:3001 (see vite.config.ts).
# - For production on Vercel: set this to your deployed Cloudflare backend, e.g.
#   VITE_API_BASE_URL=https://your-backend.workers.dev/api/v1
#
# If you prefer to keep /api relative in production and route it yourself,
# add a Vercel rewrite so /api/* forwards to your backend instead.
# VITE_API_BASE_URL=/api/v1

# In development, override the backend the Vite proxy targets (defaults to
# http://localhost:3001).
# VITE_DEV_API_TARGET=http://localhost:3001
