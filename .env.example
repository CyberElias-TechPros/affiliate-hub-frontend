# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Vite / Vercel)
#
# Every VITE_* variable is compiled INTO the client bundle. Anything here is
# public by definition. Never put a secret, token or private key in this file.
# Copy to `.env.local` for local overrides; `.env.local` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Where the browser reaches the API.
#   default "/api/v1"  -> same origin; dev proxies it to the Worker, production
#                         rewrites it (see vercel.json). This avoids CORS entirely.
# Only set an absolute URL if the API genuinely lives on another domain, and
# then add that origin to the Worker's ALLOWED_ORIGINS.
VITE_API_BASE_URL=/api/v1

# Absolute origin used to build canonical URLs, sitemap entries and OG tags.
# Must match the deployed Vercel domain or every canonical will point elsewhere.
VITE_SITE_URL=https://affiliate-hub.vercel.app

# Twitter/X handle for the twitter:site card tag. Leave blank to omit the tag.
VITE_TWITTER_HANDLE=

# ── Advertising ──────────────────────────────────────────────────────────────
# Both must be set for ads to render at all. They default to empty on purpose:
# the prototype hardcoded a publisher id in index.html, which meant every fork
# and preview deployment served someone else's ads.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=

# ── Support contacts ─────────────────────────────────────────────────────────
# Shown on the contact and help pages and used to build the WhatsApp deep link.
# WhatsApp must be E.164 digits without a leading '+'.
VITE_SUPPORT_EMAIL=support@affiliatehub.test
VITE_SUPPORT_WHATSAPP=2348012345678

# Milliseconds before an in-flight request is abandoned.
VITE_API_TIMEOUT_MS=15000
